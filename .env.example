# 复制为 .env.local（本机）或在托管平台配置环境变量。
# anon key 可安全用于浏览器/Netlify 前端；service key 只能用于服务端脚本（勿外泄）。

# Supabase 项目（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 仅供脚本/CI 使用（seed/sync、collect 后入库）：GitHub Secrets 或本地 .env
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── 后台管理系统 /admin ─────────────────────────────
# 登录密码（必填；未配置时后台整体禁用）
ADMIN_PASSWORD=
# 会话签名密钥（可选；未配置时回退 ADMIN_PASSWORD，生产建议单独配置）
ADMIN_SESSION_SECRET=
# 后台写 GitHub 的 PAT（contents 权限）；未配置时后台只读、写入会报错
GITHUB_ADMIN_TOKEN=
# 仓库 owner/name（默认 TLEON111/opc-policy-map）
GITHUB_REPO=
